{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["pos/src/*"],
      "@delegate/*": ["delegate/src/*"],
      "@menu/*": ["menu/src/*"],
      "@admin/*": ["admin/src/*"]
    }
  },
  "include": ["pos/src", "delegate/src", "menu/src", "admin/src", "vite.config.ts", "scripts"]
}
