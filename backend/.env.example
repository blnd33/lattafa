APP_NAME="Lattafa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Store day boundaries ("today's sales") follow this timezone. Duhok / Baghdad = UTC+3, no daylight saving.
APP_TIMEZONE=Asia/Baghdad

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL is the target. Create the database once with database/setup-postgres.sql,
# then put the SAME password you chose there in DB_PASSWORD.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lattafa
DB_USERNAME=lattafa
DB_PASSWORD=

# (quick local try-out without PostgreSQL:  DB_CONNECTION=sqlite  and delete the DB_HOST … DB_PASSWORD lines)

# The API is stateless (Bearer tokens). Sessions/cache/queue only need somewhere to live.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Browsers allowed to call the API (comma separated, no trailing slash) ─
# The POS, Menu and Admin web apps. Add your real domains in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:5180
# Optional regex list, e.g. to allow tablets on the shop's Wi-Fi during development:
# CORS_ALLOWED_ORIGIN_PATTERNS=#^http://192\.168\.\d+\.\d+:\d+$#

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@lattafa.example"
MAIL_FROM_NAME="${APP_NAME}"
