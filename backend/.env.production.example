# ═════════════════════════════════════════════════════════════════════════════
#  Lattafa — settings for the LIVE server
#  Copy to backend/.env on the server, fill in the <…> parts, then:
#     php artisan key:generate        (ONCE, on the first install only — see APP_KEY below)
#     php artisan migrate --force
#     php artisan optimize
#  Full steps: docs/deploy.md
# ═════════════════════════════════════════════════════════════════════════════

APP_NAME="Lattafa"
APP_ENV=production
# never true on a live server: it would show program code and settings to anyone who causes an error
APP_DEBUG=false
# Made by `php artisan key:generate`. NEVER change it after the shop has started: supervisor PIN approvals depend on
# it, so a restored backup needs the key that was in place when it was made. Keep a copy somewhere safe.
APP_KEY=
# the real address, with https — product photos are linked from it
APP_URL=https://<your-domain>
APP_TIMEZONE=Asia/Baghdad

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# one log file per day, kept 30 days; only warnings and errors
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database (created once with database/setup-postgres.sql) ──────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lattafa
DB_USERNAME=lattafa
DB_PASSWORD=<the password chosen in setup-postgres.sql>

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The menu, POS and delegate app are on this same domain, so no other site needs to call the API: keep it empty.
CORS_ALLOWED_ORIGINS=

# Only when Cloudflare / a load balancer / a hosting proxy is in front of this server (see config/trustedproxy.php).
TRUSTED_PROXIES=

# ── Nightly database backup (php artisan lattafa:backup, needs the scheduler cron line) ──
BACKUP_DAILY_AT=03:00
BACKUP_KEEP_DAYS=14
# BACKUP_PATH=/var/backups/lattafa
# BACKUP_PG_DUMP=/usr/bin/pg_dump

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@<your-domain>"
MAIL_FROM_NAME="${APP_NAME}"
